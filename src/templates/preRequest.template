<%= startMarker %>
// Auto-generated script to fetch secrets from 1Password

const SECRET_CONFIG_PATH = '<%= secretConfigPath %>';
const ONE_PASSWORD_BINARY = '<%= onePasswordBin %>';
const SECRETS_TTL_MS = <%= secretsTtlMs %>;

if (bru.isSafeMode()) {
    throw new Error('Developer Mode must be enabled for fetching secrets from 1Password.');
}

async function fetchSecretsFrom1Password() {
    const env = bru.getEnvName();
    const secretsExpiredAt = bru.getEnvVar('OP_SECRETS_EXPIRED_AT');
    const isExpired = !secretsExpiredAt || new Date(secretsExpiredAt) <= new Date();

    if (env && isExpired) {
        const { exec } = require('child_process');
        const { promisify } = require('util');
        const { readFileSync, existsSync } = require('fs');
        const execAsync = promisify(exec);
        const configPath = `${bru.cwd()}/${SECRET_CONFIG_PATH}`;

        if (!existsSync(configPath)) {
            console.log(
                `No secrets file found at ${configPath}, skip fetching secrets from 1Password.`
            );
            return;
        }

        const config = JSON.parse(readFileSync(configPath, 'utf8'));
        const secrets = config[env];

        if (!secrets || secrets.length === 0) {
            console.log(`No secrets found for ${env}, skip fetching secrets from 1Password.`);
            return;
        }

        console.log(`Fetching secrets for ${env} environment from 1Password...`);

        // Send the first request synchronously to validate the 1Password session
        const [first, ...rest] = secrets;
        const { stdout: firstValue } = await execAsync(`${ONE_PASSWORD_BINARY} read "${first.value}"`);
        bru.setEnvVar(first.name, firstValue.trim());

        if (rest.length > 0) {
            const promises = rest.map(async secret => {
                const { stdout } = await execAsync(`${ONE_PASSWORD_BINARY} read "${secret.value}"`);
                bru.setEnvVar(secret.name, stdout.trim());
            });

            await Promise.all(promises).catch(error => {
                console.error(error);
                throw new Error('Failed to fetch secrets from 1Password! Check console log for more details.');
            });
        }

        const expiresAt = new Date(Date.now() + SECRETS_TTL_MS).toISOString();
        bru.setEnvVar('OP_SECRETS_EXPIRED_AT', expiresAt);
        console.log(
            `Secrets fetched successfully for ${env}. They will be refetched after ${expiresAt}.`
        );
    }
}

// Execute the function
await fetchSecretsFrom1Password();

<%= endMarker %>
